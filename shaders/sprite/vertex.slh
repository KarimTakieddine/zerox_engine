#version 450 core

in vec3 position;
in vec3 color;
in vec2 uv;

uniform CameraMatrices
{
    mat4 c_projection;
    mat4 c_localToWorld;
    mat4 c_localRotation;
    mat4 c_view;
};

uniform mat4 transform[3];
uniform vec2 uvParams[2];

out vec3 vertexColor;
out vec2 vertexUV;

void main() {
	mat4 cameraTransform		= c_localToWorld * c_localRotation;
	mat4 cameraViewTransform    = inverse(cameraTransform) * c_view;
    mat4 model                  = transform[0] * transform[1] * transform[2];

    gl_Position = c_projection * cameraViewTransform * model * vec4(position, 1.0);

    vertexColor = color;
    vertexUV    = uv * uvParams[0];
}