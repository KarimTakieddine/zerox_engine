#version 450 core

in vec3 vertexColor;
in vec2 vertexUV;

uniform vec2 uvParams[2];

uniform vec4 materialColor;
uniform uvec2 tileSize;

uniform sampler2D textureSampler;

out vec4 oColor;

void main() {
    vec2 localTiledUV = fract(vertexUV * vec2(tileSize));

    vec2 scaledLocalUV = localTiledUV * uvParams[0];

    vec2 finalUV = scaledLocalUV + uvParams[1];

    vec2 dx = dFdx(vertexUV * uvParams[0]);
    vec2 dy = dFdy(vertexUV * uvParams[0]);

    oColor = textureGrad(textureSampler, finalUV, dx, dy) * materialColor;
}