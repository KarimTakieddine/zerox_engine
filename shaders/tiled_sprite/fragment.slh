#version 450 core

in vec3 vertexColor;
in vec2 vertexUV;

uniform vec4 materialColor;
uniform vec2 uvScale;
uniform uvec2 tileSize;
uniform vec2 textureOffset;

uniform sampler2D textureSampler;

out vec4 oColor;

void main() {
    vec2 localTiledUV = fract(vertexUV * vec2(tileSize));

    vec2 scaledLocalUV = localTiledUV * uvScale;

    vec2 finalUV = scaledLocalUV + textureOffset;

    vec2 dx = dFdx(vertexUV * uvScale);
    vec2 dy = dFdy(vertexUV * uvScale);

    oColor = textureGrad(textureSampler, finalUV, dx, dy) * materialColor;
}