#version 450 core

in vec3 vertexColor;
in vec2 vertexUV;

uniform vec4 materialColor;
uniform vec2 textureOffset;
uniform uint layer;

out vec4 oColor;

uniform sampler2DArray textureArraySampler;

void main() {
    oColor = texture(textureArraySampler, vec3(vertexUV + textureOffset, float(layer))) * materialColor;
}