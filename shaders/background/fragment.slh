#version 450 core

in vec3 vertexColor;
in vec2 vertexUV;

uniform vec4 materialColor;
uniform vec2 textureOffset;
uniform uint layer;

uniform sampler2DArray textureSampler;

out vec4 oColor;

void main() {
    oColor = texture(textureSampler, vec3(vertexUV + textureOffset, float(layer))) * materialColor;
}