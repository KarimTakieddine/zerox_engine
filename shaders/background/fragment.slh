#version 450 core

in vec3 vertexColor;
in vec2 vertexUV;

uniform vec2 uvParams[2];
uniform vec4 materialColor;
uniform uint layer;

out vec4 oColor;

uniform sampler2DArray tArraySampler;

void main() {
    oColor = texture(tArraySampler, vec3(vertexUV + uvParams[1], float(layer))) * materialColor;
}